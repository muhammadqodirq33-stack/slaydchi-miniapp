            <div class="menu-grid">
              <button class="menu-tile" onclick="navTo('subjects')"><div class="menu-icon" style="background:var(--brand-soft);color:var(--brand);">${ICONS.book}</div><div class="menu-tile-title">${esc(t('subjects'))}</div><div class="menu-tile-sub">Kunlik & semestr baholar, topshiriqlar</div></button>
              <button class="menu-tile" onclick="navTo('eduplan')"><div class="menu-icon" style="background:var(--violet-soft);color:var(--violet);">${ICONS.layers}</div><div class="menu-tile-title">${esc(t('eduplan'))}</div><div class="menu-tile-sub">O'quv reja, GPA va qarzdorlik</div></button>
              <button class="menu-tile" onclick="navTo('exams')"><div class="menu-icon" style="background:var(--warning-soft);color:var(--warning);">${ICONS.award}</div><div class="menu-tile-title">${esc(t('exams'))}</div><div class="menu-tile-sub">Imtihonlar jadvali</div></button>
              <button class="menu-tile" onclick="navTo('payment')"><div class="menu-icon" style="background:var(--success-soft);color:var(--success);">${ICONS.wallet}</div><div class="menu-tile-title">${esc(t('payment'))}</div><div class="menu-tile-sub">Kontrakt, stipendiya, subsidiya</div></button>
              <button class="menu-tile" onclick="navTo('services')"><div class="menu-icon" style="background:var(--teal-soft);color:var(--teal);">${ICONS.file}</div><div class="menu-tile-title">${esc(t('services'))}</div><div class="menu-tile-sub">Ketish varaqasi, apellyatsiya</div></button>
              <button class="menu-tile" onclick="navTo('library')"><div class="menu-icon" style="background:var(--brand-soft);color:var(--brand);">${ICONS.search}</div><div class="menu-tile-title">${esc(t('library'))}</div><div class="menu-tile-sub">Unilibrary elektron kitoblar</div></button>
            </div>
          </div>

          <div class="card">
            <div class="card-title"><span>${esc(t('oneidServices'))}</span><span class="pill pill-brand">OneID / my.hemis.uz</span></div>
            <p style="font-size:12px;color:var(--text-secondary);margin-bottom:12px;">${esc(t('oneidHint'))}</p>
            <div class="menu-grid">
              ${oneIdLinks.map(l => `
                <button class="menu-tile" onclick="openExternal('${l.url}')">
                  <div class="menu-icon" style="background:var(--surface-sunken);color:var(--brand);">${ICONS.external}</div>
                  <div class="menu-tile-title">${esc(l.title)}</div>
                  <div class="menu-tile-sub">${esc(l.sub)}</div>
                </button>
              `).join('')}
            </div>
          </div>
        </div>
      `;
    }

    function renderProfile() {
      const p = state.profile || {};
      const rows = [
        ['F.I.Sh', p.full_name], ['Talaba ID', p.student_login], ['OTM', p.university],
        ['Fakultet', p.faculty], ['Yo\'nalish', p.specialty], ['Guruh', p.group],
        ['Kurs / Semestr', [p.course, p.semester].filter(Boolean).join(' • ')],
        ['Ta\'lim turi / shakli', [p.education_type, p.education_form].filter(Boolean).join(' • ')],
        ['To\'lov shakli', p.payment_form], ['O\'rtacha GPA', p.avg_gpa],
        ['Telefon', p.phone], ['Email', p.email], ['Tug\'ilgan sana', p.birth_date],
        ['Pasport / JSHSHIR', [p.passport, p.jshshir].filter(Boolean).join(' • ')],
        ['Manzil', [p.region, p.district, p.address].filter(Boolean).join(', ')],
        ['Turar joy', p.accommodation],
      ].filter(([, v]) => v);
      return `
        <div class="stack">
          <div class="card">
            <div class="card-title">
              <span>${esc(t('profile'))}</span>
              <button class="btn btn-sm btn-ghost" onclick="navTo('settings')">${ICONS.settings} ${esc(t('settings'))}</button>
            </div>
            ${rows.map(([k, v]) => `
              <div class="row-item">
                <span style="font-size:12.5px;color:var(--text-secondary);">${esc(k)}</span>
                <span style="font-weight:600;text-align:right;">${esc(v)}</span>
              </div>
            `).join('')}
          </div>
          <div class="card" style="display:flex;flex-wrap:wrap;gap:10px;">
            <button class="btn btn-primary" onclick="requestPdfReport()">📄 ${esc(t('pdfReport'))}</button>
            <button class="btn btn-ghost" onclick="state.ui.showLoginModal=true;render();">🔄 ${esc(t('switchAcc'))}</button>
            <button class="btn btn-danger" onclick="handleLogout()">🚪 ${esc(t('logout'))}</button>
          </div>
        </div>
      `;
    }

    function renderSettings() {
      const st = state.settings;
      const mutedSet = new Set(st.muted || []);
      const subjects = (state.attendance.report || []).map(r => r.subject);
      return `
        <div class="stack">
          <div class="card">
            <div class="card-title">${esc(t('notifTitle'))}</div>
            <div class="row-item">
              <span>${esc(t('notifEnable'))}</span>
              <button class="switch ${st.notifications_enabled ? 'on' : ''}" onclick="updateSetting({notifications_enabled: ${st.notifications_enabled ? 0 : 1}})"></button>
            </div>
            <div class="row-item">
              <span>${esc(t('dailyRep'))}</span>
              <button class="switch ${st.daily_enabled ? 'on' : ''}" onclick="updateSetting({daily_enabled: ${st.daily_enabled ? 0 : 1}})"></button>
            </div>
            <div class="row-item">
              <span>${esc(t('weeklyRep'))}</span>
              <button class="switch ${st.weekly_enabled ? 'on' : ''}" onclick="updateSetting({weekly_enabled: ${st.weekly_enabled ? 0 : 1}})"></button>
            </div>
            <div class="row-item" style="flex-wrap:wrap;">
              <span>${esc(t('repTime'))}</span>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                ${(st.report_time_choices || []).map(tm => `
                  <button class="btn btn-sm ${st.report_time === tm ? 'btn-primary' : 'btn-ghost'}" onclick="updateSetting({report_time:'${esc(tm)}'})">${esc(tm)}</button>
                `).join('')}
              </div>
            </div>
            <div class="row-item" style="flex-wrap:wrap;">
              <span>${esc(t('riskThr'))}</span>
              <div style="display:flex;gap:6px;flex-wrap:wrap;">
                ${(st.threshold_choices || []).map(th => `
                  <button class="btn btn-sm ${Number(st.alert_threshold) === Number(th) ? 'btn-primary' : 'btn-ghost'}" onclick="updateSetting({alert_threshold:${Number(th)}})">${esc(th)}%</button>
                `).join('')}
              </div>
            </div>
          </div>

          ${subjects.length ? `
            <div class="card">
              <div class="card-title">${esc(t('mutedSubj'))}</div>
              ${subjects.map(s => `
                <div class="row-item">
                  <span>${esc(s)}</span>
                  <button class="btn btn-sm ${mutedSet.has(s) ? 'btn-danger' : 'btn-ghost'}" data-subj="${esc(s)}" onclick="toggleMuteSubject(this.dataset.subj)">
                    ${mutedSet.has(s) ? '🔕 O\'chirilgan' : '🔔 Faol'}
                  </button>
                </div>
              `).join('')}
            </div>
          ` : ''}
        </div>
      `;
    }

    function render() {
      renderChrome();
      const root = document.getElementById('appRoot');
      if (state.loading) {
        root.innerHTML = `<div class="card empty-box">${esc(t('loading'))}</div>`;
        return;
      }
      if (!state.authenticated || state.ui.showLoginModal) {
        root.innerHTML = renderLoginView();
        return;
      }
      const views = {
        dashboard: renderDashboard,
        timetable: renderTimetable,
        attendance: renderAttendance,
        subjects: renderSubjects,
        eduplan: renderEduplan,
        exams: renderExams,
        payment: renderPayment,
        services: renderServices,
        library: renderLibrary,
        useful: renderUseful,
        profile: renderProfile,
        settings: renderSettings,
      };
      root.innerHTML = (views[state.page] || renderDashboard)();
    }

    async function init() {
      try {
        const snap = await decodeUrlSnapshot();
        if (snap) applySnapshotData(snap);
      } catch (e) {}
      render();

      if (API_BASE && (INIT_DATA || (UID && SIG))) {
        try {
          const data = await apiCall('/api/bootstrap');
          applyBootstrapPayload(data);
          render();
        } catch (e) {}
      }
    }

    init();
  </script>
</body>
</html>
