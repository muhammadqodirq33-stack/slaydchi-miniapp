        if (page === 'exams' && !state.exams.length) loadSection('exams');
        if (page === 'eduplan' && !(state.eduplan.gpa_list || []).length) loadSection('eduplan');
        if (page === 'services' && !(state.services.clearance || []).length) loadSection('services');
        if (page === 'subjects' && !(state.subjectDetail.tasks || []).length) loadSection('subject_detail');
        if (page === 'library' && !state.libraryItems.length) loadLibrary('');
      }
    }

    async function loadSection(name) {
      try {
        const data = await apiCall(`/api/section/${name}`);
        if (name === 'exams') state.exams = data.exams || [];
        if (name === 'eduplan') state.eduplan = data;
        if (name === 'services') state.services = data;
        if (name === 'subject_detail') state.subjectDetail = data;
        if (name === 'payment') state.finance = { ...state.finance, ...data };
        render();
      } catch (e) {}
    }

    async function loadLibrary(q) {
      state.ui.libQuery = q;
      try {
        const data = await apiCall(`/api/section/library?q=${encodeURIComponent(q)}`);
        state.libraryItems = data.items || [];
        render();
      } catch (e) {
        openExternal(`https://unilibrary.uz/literature?name=${encodeURIComponent(q)}`);
      }
    }

    async function forceRefresh() {
      const btn = document.getElementById('refreshBtn');
      btn.classList.add('spinning');
      if (API_BASE) {
        try {
          const data = await apiCall('/api/bootstrap?force=1');
          applyBootstrapPayload(data);
          showToast('Ma\'lumotlar yangilandi');
          render();
          btn.classList.remove('spinning');
          return;
        } catch (e) {}
      }
      btn.classList.remove('spinning');
      sendToBot({ action: 'refresh' });
    }

    function toggleTheme() {
      const root = document.documentElement;
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      root.classList.toggle('dark', next === 'dark');
      root.style.colorScheme = next;
      try { localStorage.setItem('hemis_theme', JSON.stringify({ color: next })); } catch (e) {}
      renderChrome();
    }

    async function cycleLanguage() {
      const order = ['uz', 'ru', 'en'];
      state.lang = order[(order.indexOf(state.lang) + 1) % order.length];
      state.settings.language = state.lang;
      render();
      if (state.liveApi) {
        try { await apiCall('/api/settings', { method: 'POST', body: JSON.stringify({ language: state.lang }) }); } catch (e) {}
      }
    }

    async function handleLoginSubmit(ev) {
      ev.preventDefault();
      const login = document.getElementById('loginInput').value.trim();
      const password = document.getElementById('pwdInput').value;
      const errBox = document.getElementById('loginErr');
      const submitBtn = document.getElementById('loginSubmitBtn');
      if (!login || !password) {
        errBox.textContent = 'Login va parolni kiriting';
        errBox.style.display = 'block';
        return;
      }
      submitBtn.disabled = true;
      submitBtn.textContent = '...';
      errBox.style.display = 'none';
      if (API_BASE) {
        try {
          const res = await apiCall('/api/login', {
            method: 'POST',
            body: JSON.stringify({ login, password, lang: state.lang })
          });
          applyBootstrapPayload(res);
          state.ui.showLoginModal = false;
          state.page = 'dashboard';
          showToast('Muvaffaqiyatli ulandi!');
          render();
          return;
        } catch (e) {
          if (e.message !== 'NO_API' && !String(e.message).includes('Failed to fetch')) {
            errBox.textContent = e.message;
            errBox.style.display = 'block';
            submitBtn.disabled = false;
            submitBtn.textContent = t('signIn');
            return;
          }
        }
      }
      sendToBot({ action: 'login', login, password, lang: state.lang });
    }

    async function handleQrSubmit(code) {
      if (!code) return;
      if (state.liveApi) {
        try {
          const res = await apiCall('/api/qr-attendance', { method: 'POST', body: JSON.stringify({ code }) });
          showToast(res.message || (res.success ? 'Belgilandi' : 'Tasdiqlanmadi'));
          return;
        } catch (e) {
          showToast(e.message);
          return;
        }
      }
      sendToBot({ action: 'qr_attendance', code });
    }

    function triggerQrScan() {
      if (tg && tg.showScanQrPopup) {
        tg.showScanQrPopup({ text: 'HEMIS QR-kodni skanerlang' }, (qrText) => {
          if (qrText) {
            handleQrSubmit(qrText);
            return true;
          }
        });
      } else {
        const inp = document.getElementById('qrManualInput');
        if (inp) inp.focus();
        showToast('QR-kod matnini kiriting');
      }
    }

    async function updateSetting(patch) {
      state.settings = { ...state.settings, ...patch };
      if (patch.language) state.lang = patch.language;
      render();
      if (state.liveApi) {
        try {
          const res = await apiCall('/api/settings', { method: 'POST', body: JSON.stringify(patch) });
          if (res.settings) state.settings = { ...state.settings, ...res.settings };
          showToast('Saqlandi');
          return;
        } catch (e) {}
      }
      sendToBot({ action: 'save_settings', settings: state.settings });
    }

    async function toggleMuteSubject(subj) {
      const m = new Set(state.settings.muted || []);
      if (m.has(subj)) m.delete(subj); else m.add(subj);
      state.settings.muted = Array.from(m);
      render();
      if (state.liveApi) {
        try {
          await apiCall('/api/settings', { method: 'POST', body: JSON.stringify({ toggle_mute: subj }) });
          showToast('Yangilandi');
        } catch (e) {}
      } else {
        sendToBot({ action: 'save_settings', settings: state.settings });
      }
    }

