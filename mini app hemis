        let listHtml = '';
        if (!dg.length) {
          listHtml = `<div class="card empty-box">${esc(t('noData'))}</div>`;
        } else if (mode === 'subject') {
          const bySubj = {};
          dg.forEach(g => { (bySubj[g.subject] = bySubj[g.subject] || []).push(g); });
          listHtml = Object.entries(bySubj).map(([subj, items]) => {
            const nums = items.map(x => Number(x.grade_num)).filter(n => !Number.isNaN(n));
            const avg = nums.length ? (nums.reduce((a, b) => a + b, 0) / nums.length).toFixed(1) : '-';
            return `
              <div class="card">
                <div class="card-title"><span>${esc(subj)}</span><span class="pill pill-brand">O'rtacha: ${esc(avg)}</span></div>
