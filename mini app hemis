    function computeRadarFromSchedule() {
      const now = new Date();
      const wd = now.getDay() === 0 ? 7 : now.getDay();
      const lessons = (state.schedule[wd] || state.schedule[String(wd)] || []).slice();
      if (!lessons.length || wd === 7) return { status: 'day_off', lessons: [] };
      const toMin = (hhmm) => {
        const [h, m] = String(hhmm || '00:00').split(':').map(Number);
        return (h || 0) * 60 + (m || 0);
      };
      lessons.sort((a, b) => toMin(a.start_time) - toMin(b.start_time));
      const nowM = now.getHours() * 60 + now.getMinutes();
      const firstS = toMin(lessons[0].start_time);
      const lastE = toMin(lessons[lessons.length - 1].end_time);
      if (nowM < firstS) return { status: 'before_classes', lessons, target: lessons[0], left: firstS - nowM };
      if (nowM > lastE) return { status: 'after_classes', lessons };
      for (let i = 0; i < lessons.length; i++) {
        const cur = lessons[i];
        const s = toMin(cur.start_time), e = toMin(cur.end_time);
        if (nowM >= s && nowM <= e) return { status: 'in_class', lessons, target: cur, left: e - nowM };
        if (i < lessons.length - 1) {
          const nxt = lessons[i + 1];
          const ns = toMin(nxt.start_time);
          if (nowM > e && nowM < ns) return { status: 'in_break', lessons, target: nxt, left: ns - nowM };
        }
      }
      return { status: 'after_classes', lessons };
    }

