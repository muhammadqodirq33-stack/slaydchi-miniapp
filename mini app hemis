<!doctype html>
<html lang="uz" data-theme="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>MY.HEMIS.UZ — Talaba Mini Ilovasi</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Onest:wght@300;400;500;600;700;800&display=swap" />
  <script>
    (function () {
      try {
        var saved = JSON.parse(localStorage.getItem('hemis_theme') || 'null');
        var tgDark = window.Telegram && window.Telegram.WebApp && window.Telegram.WebApp.colorScheme === 'dark';
        var dark = saved ? saved.color === 'dark' : tgDark;
        var root = document.documentElement;
        root.dataset.theme = dark ? 'dark' : 'light';
        root.classList.toggle('dark', dark);
        root.style.colorScheme = dark ? 'dark' : 'light';
      } catch (e) {}
    })();
  </script>
  <style>
    :root {
      --brand: #1677ff;
      --brand-hover: #4096ff;
      --brand-active: #0958d9;
      --brand-soft: #e9f2ff;
      --brand-border: #bedaff;
      --brand-contrast: #ffffff;
      --success: #16c757;
      --success-soft: #e7f7ed;
      --warning: #d98204;
      --warning-soft: #fdf3e2;
      --danger: #dc2626;
      --danger-soft: #fdeced;
      --violet: #7a5fd2;
      --violet-soft: #f2eefc;
      --teal: #1ea58c;
      --teal-soft: #e6f7f4;
      --app-bg: #fbfbfb;
      --surface: #ffffff;
      --surface-raised: #ffffff;
      --surface-sunken: #f7f8fa;
      --surface-hover: #f3f5f8;
      --surface-active: #eaeef5;
      --border: #e6eaf0;
      --border-strong: #d4dbe5;
      --text: #14181f;
      --text-secondary: #5a6475;
      --text-tertiary: #8c96a7;
      --shadow-sm: 0 1px 2px rgba(20, 24, 31, 0.04);
      --shadow-md: 0 6px 20px rgba(20, 24, 31, 0.06);
      --sidebar-w: 236px;
      --header-h: 58px;
      --radius: 12px;
      --radius-lg: 16px;
      --lab-glass: rgba(120, 152, 205, 0.14);
    }

    :root[data-theme="dark"] {
      --brand: #3b87f7;
      --brand-hover: #5c9dff;
      --brand-active: #1f6ad6;
      --brand-soft: #16233a;
      --brand-border: #23406b;
      --brand-contrast: #ffffff;
      --success: #3dd68c;
      --success-soft: #10261c;
      --warning: #f0b354;
      --warning-soft: #2a2013;
      --danger: #f4787b;
      --danger-soft: #2c1618;
      --violet: #a08cf0;
      --violet-soft: #211d36;
      --teal: #3cc7ab;
      --teal-soft: #112924;
      --app-bg: #0a0c10;
      --surface: #14171d;
      --surface-raised: #1a1e26;
      --surface-sunken: #101318;
      --surface-hover: #1e232c;
      --surface-active: #262c37;
      --border: #232934;
      --border-strong: #323a49;
      --text: #eef1f6;
      --text-secondary: #a3adbd;
      --text-tertiary: #737f91;
      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 10px 26px rgba(0, 0, 0, 0.35);
      --lab-glass: rgba(140, 170, 220, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; -webkit-tap-highlight-color: transparent; }

    html, body {
      font-family: 'Onest', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: var(--app-bg);
      color: var(--text);
      min-height: 100vh;
      font-size: 14px;
      line-height: 1.45;
      overflow-x: hidden;
    }

    button, input, select { font-family: inherit; color: inherit; }
    a { color: var(--brand); text-decoration: none; }

    /* Ambient Lab Background (my.hemis.uz style) */
    .lab-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        radial-gradient(620px 340px at 10% -4%, var(--brand-soft), transparent 65%),
        radial-gradient(520px 300px at 96% 8%, var(--lab-glass), transparent 65%);
      opacity: 0.72;
    }

    /* App Shell */
    .app-shell {
      position: relative;
      z-index: 1;
      display: flex;
      min-height: 100vh;
    }

    /* Sidebar (Desktop >= 840px) */
    .sidebar {
      width: var(--sidebar-w);
      flex-shrink: 0;
      background: var(--surface);
      border-right: 1px solid var(--border);
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      display: flex;
      flex-direction: column;
      z-index: 30;
    }
    .sidebar-brand {
      height: var(--header-h);
      padding: 0 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 1px solid var(--border);
    }
    .brand-logo {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: linear-gradient(135deg, var(--brand), #0958d9);
      color: #fff;
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 14px;
      letter-spacing: -0.02em;
      box-shadow: 0 4px 12px rgba(22, 119, 255, 0.25);
    }
    .brand-title { font-weight: 700; font-size: 15px; letter-spacing: -0.01em; }
    .brand-sub { font-size: 11px; color: var(--text-tertiary); display: block; margin-top: -2px; }

    .sidebar-nav {
      flex: 1;
      overflow-y: auto;
      padding: 12px 10px 24px;
    }
    .nav-group-label {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-tertiary);
      padding: 12px 10px 6px;
    }
    .nav-item {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 12px;
      border-radius: 10px;
      border: 0;
      background: transparent;
      color: var(--text-secondary);
      font-size: 13.5px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.15s, color 0.15s;
      text-align: left;
      margin-bottom: 2px;
    }
    .nav-item:hover { background: var(--surface-hover); color: var(--text); }
    .nav-item.active {
      background: var(--brand-soft);
      color: var(--brand);
      font-weight: 600;
    }
    .nav-item .badge-ext {
      margin-left: auto;
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 99px;
      background: var(--surface-sunken);
      color: var(--text-tertiary);
      border: 1px solid var(--border);
    }

    /* Main Column */
    .main-col {
      flex: 1;
      margin-left: var(--sidebar-w);
      display: flex;
      flex-direction: column;
      min-width: 0;
    }

    /* Top Header */
    .topbar {
      height: var(--header-h);
      background: color-mix(in srgb, var(--surface) 88%, transparent);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
      position: sticky;
      top: 0;
      z-index: 25;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }
    .topbar-left { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .mobile-brand { display: none; align-items: center; gap: 8px; }
    .page-title-wrap { min-width: 0; }
    .page-title {
      font-size: 15.5px;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .page-sub {
      font-size: 11.5px;
      color: var(--text-tertiary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .topbar-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
    .icon-btn {
      height: 36px;
      min-width: 36px;
      padding: 0 10px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-secondary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      cursor: pointer;
      font-size: 12.5px;
      font-weight: 600;
      transition: background 0.15s, border-color 0.15s;
    }
    .icon-btn:hover { background: var(--surface-hover); border-color: var(--border-strong); color: var(--text); }
    .icon-btn.spinning svg { animation: spin 0.9s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }

    .avatar-chip {
      height: 36px;
      padding: 3px 10px 3px 4px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: var(--surface);
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      font-size: 12.5px;
      font-weight: 600;
    }
    .avatar-circle {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--brand);
      color: #fff;
      display: grid;
      place-items: center;
      font-size: 11.5px;
      font-weight: 700;
    }

    /* Main Content Area */
    .content-area {
      padding: 18px 20px 32px;
      max-width: 1160px;
      width: 100%;
      margin: 0 auto;
    }

    /* Cards & Grids */
    .card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
      box-shadow: var(--shadow-sm);
    }
    .card-title {
      font-size: 14.5px;
      font-weight: 700;
      margin-bottom: 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; }
    .stack { display: flex; flex-direction: column; gap: 12px; }

    /* Hero Student Card */
    .hero-card {
      background: linear-gradient(135deg, #1677ff 0%, #0958d9 60%, #1d39c4 100%);
      color: #fff;
      border-radius: var(--radius-lg);
      padding: 18px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 10px 28px rgba(22, 119, 255, 0.24);
    }
    .hero-card::after {
      content: "";
      position: absolute;
      right: -40px;
      top: -40px;
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      pointer-events: none;
    }
    .hero-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; position: relative; z-index: 1; }
    .hero-name { font-size: 18px; font-weight: 800; letter-spacing: -0.01em; line-height: 1.25; }
    .hero-meta { font-size: 12.5px; opacity: 0.9; margin-top: 4px; }
    .hero-badges { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; position: relative; z-index: 1; }
    .hero-pill {
      padding: 4px 10px;
      border-radius: 99px;
      background: rgba(255, 255, 255, 0.18);
      backdrop-filter: blur(4px);
      font-size: 11.5px;
      font-weight: 600;
    }

    /* Stat KPI */
    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      cursor: pointer;
      transition: transform 0.14s, border-color 0.14s;
    }
    .kpi-card:hover { transform: translateY(-1px); border-color: var(--brand-border); }
    .kpi-label { font-size: 12px; color: var(--text-secondary); font-weight: 500; display: flex; align-items: center; justify-content: space-between; }
    .kpi-val { font-size: 22px; font-weight: 800; letter-spacing: -0.02em; }
    .kpi-sub { font-size: 11.5px; color: var(--text-tertiary); }

    /* Pills / Badges / Buttons */
    .pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 99px;
      font-size: 11.5px;
      font-weight: 600;
    }
    .pill-brand { background: var(--brand-soft); color: var(--brand); }
    .pill-success { background: var(--success-soft); color: var(--success); }
    .pill-warning { background: var(--warning-soft); color: var(--warning); }
    .pill-danger { background: var(--danger-soft); color: var(--danger); }
    .pill-violet { background: var(--violet-soft); color: var(--violet); }
    .pill-neutral { background: var(--surface-sunken); color: var(--text-secondary); border: 1px solid var(--border); }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      padding: 10px 16px;
      border-radius: 10px;
      font-size: 13.5px;
      font-weight: 600;
      border: 1px solid transparent;
      cursor: pointer;
      transition: all 0.15s;
    }
    .btn-primary { background: var(--brand); color: var(--brand-contrast); }
    .btn-primary:hover { background: var(--brand-hover); }
    .btn-primary:disabled { opacity: 0.55; cursor: not-allowed; }
    .btn-ghost { background: var(--surface-sunken); border-color: var(--border); color: var(--text); }
    .btn-ghost:hover { background: var(--surface-hover); }
    .btn-danger { background: var(--danger-soft); color: var(--danger); border-color: color-mix(in srgb, var(--danger) 25%, transparent); }
    .btn-sm { padding: 6px 11px; font-size: 12px; border-radius: 8px; }

    /* Segmented Tabs */
    .tabs {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 14px;
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }
    .tab-btn {
      padding: 8px 14px;
      border-radius: 10px;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text-secondary);
      font-size: 12.5px;
      font-weight: 600;
      white-space: nowrap;
      cursor: pointer;
    }
    .tab-btn.active {
      background: var(--brand);
      color: #fff;
      border-color: var(--brand);
    }

    /* Progress Bar */
    .progress-track {
      width: 100%;
      height: 7px;
      border-radius: 99px;
      background: var(--surface-sunken);
      overflow: hidden;
    }
    .progress-fill { height: 100%; border-radius: 99px; transition: width 0.3s ease; }

    /* List Row */
    .row-item {
      padding: 12px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--surface-sunken);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }
    .row-item + .row-item { margin-top: 8px; }

    /* Form Controls */
    .field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    .field label { font-size: 12.5px; font-weight: 600; color: var(--text-secondary); }
    .input-wrap { position: relative; display: flex; align-items: center; }
    .input {
      width: 100%;
      height: 42px;
      padding: 0 13px;
      border-radius: 10px;
      border: 1px solid var(--border-strong);
      background: var(--surface);
      font-size: 14px;
      outline: none;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .input:focus { border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-soft); }
    .eye-btn {
      position: absolute;
      right: 10px;
      background: none;
      border: 0;
      color: var(--text-tertiary);
      cursor: pointer;
      padding: 4px;
    }

    /* Menu Grid (Useful / Profile) */
    .menu-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 10px;
    }
    .menu-tile {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 14px;
      padding: 14px 12px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      cursor: pointer;
      text-align: left;
      transition: border-color 0.15s, transform 0.14s;
    }
    .menu-tile:hover { border-color: var(--brand-border); transform: translateY(-1px); }
    .menu-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: grid;
      place-items: center;
    }
    .menu-tile-title { font-size: 13px; font-weight: 700; line-height: 1.25; }
    .menu-tile-sub { font-size: 11.5px; color: var(--text-tertiary); line-height: 1.3; }

    /* Table */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    th, td { padding: 10px 12px; text-align: left; border-bottom: 1px solid var(--border); }
    th { font-size: 11.5px; font-weight: 600; color: var(--text-tertiary); text-transform: uppercase; background: var(--surface-sunken); }

    /* Radar banner */
    .radar-banner {
      border-radius: 14px;
      padding: 14px;
      background: var(--brand-soft);
      border: 1px solid var(--brand-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    /* Switch toggle */
    .switch {
      position: relative;
      width: 44px;
      height: 24px;
      border-radius: 99px;
      background: var(--border-strong);
      border: 0;
      cursor: pointer;
      transition: background 0.18s;
      flex-shrink: 0;
    }
    .switch::after {
      content: "";
      position: absolute;
      top: 3px;
      left: 3px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #fff;
      transition: transform 0.18s;
    }
    .switch.on { background: var(--brand); }
    .switch.on::after { transform: translateX(20px); }

    /* Mobile Bottom Nav */
    .bottom-nav {
      display: none;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      height: 64px;
      background: color-mix(in srgb, var(--surface) 94%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid var(--border);
      z-index: 40;
      padding: 4px 6px env(safe-area-inset-bottom, 4px);
    }
    .bnav-btn {
      flex: 1;
      background: transparent;
      border: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 3px;
      font-size: 10.5px;
      font-weight: 600;
      color: var(--text-tertiary);
      cursor: pointer;
      border-radius: 10px;
    }
    .bnav-btn.active { color: var(--brand); }

    /* Toast & Status Banner */
    .toast {
      position: fixed;
      top: 68px;
      right: 16px;
      z-index: 90;
      background: var(--text);
      color: var(--surface);
      padding: 10px 14px;
      border-radius: 10px;
      font-size: 12.5px;
      font-weight: 600;
      box-shadow: var(--shadow-md);
      max-width: 320px;
      display: none;
    }
    .toast.show { display: block; animation: fadeIn 0.2s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-6px); } to { opacity: 1; transform: translateY(0); } }

    .offline-bar {
      margin-bottom: 12px;
      padding: 9px 12px;
      border-radius: 10px;
      font-size: 12px;
      background: var(--warning-soft);
      color: var(--warning);
      border: 1px solid color-mix(in srgb, var(--warning) 25%, transparent);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .empty-box {
      text-align: center;
      padding: 32px 16px;
      color: var(--text-tertiary);
      font-size: 13.5px;
    }

    .login-wrap {
      max-width: 440px;
      margin: 18px auto;
    }

    @media (max-width: 839px) {
      .sidebar { display: none; }
      .main-col { margin-left: 0; padding-bottom: 72px; }
      .mobile-brand { display: flex; }
      .page-title-wrap { display: none; }
      .topbar { padding: 0 12px; }
      .content-area { padding: 12px 12px 24px; }
      .bottom-nav { display: flex; }
      .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-3 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
      .grid-2 { grid-template-columns: repeat(1, minmax(0, 1fr)); }
      .menu-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .avatar-name-text { display: none; }
    }
  </style>
</head>
<body>
  <div class="lab-bg"></div>
  <div id="toast" class="toast"></div>

  <div class="app-shell">
    <!-- Desktop Sidebar -->
    <aside class="sidebar" id="sidebar">
      <div class="sidebar-brand">
        <div class="brand-logo">H</div>
        <div>
          <div class="brand-title">MY.HEMIS.UZ</div>
          <span class="brand-sub" id="sidebarSub">Talaba kabineti</span>
        </div>
      </div>
      <nav class="sidebar-nav" id="sidebarNav"></nav>
    </aside>

    <!-- Main Column -->
    <div class="main-col">
      <header class="topbar">
        <div class="topbar-left">
          <div class="mobile-brand" onclick="navTo('dashboard')" style="cursor:pointer;">
            <div class="brand-logo" style="width:30px;height:30px;font-size:12px;">H</div>
            <div>
              <div style="font-weight:800;font-size:14px;line-height:1.1;">MY.HEMIS.UZ</div>
              <span style="font-size:10.5px;color:var(--text-tertiary);" id="mobileUniLabel">Talaba tizimi</span>
            </div>
          </div>
          <div class="page-title-wrap">
            <div class="page-title" id="headerTitle">Bosh sahifa</div>
            <div class="page-sub" id="headerSub">Oliy ta'lim jarayonlarini boshqarish tizimi</div>
          </div>
        </div>
        <div class="topbar-actions">
          <button class="icon-btn" id="refreshBtn" onclick="forceRefresh()" title="Yangilash">
